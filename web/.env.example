# Where the data files are (serving/export_static.py writes them next to the site). The build
# reads them to pre-render pages; in development Vite proxies /data there.
VITE_DATA_URL=https://clearhealthcareprices.com

# Google AdSense (app/components/ad-slot.tsx): the publisher ID and a display ad unit's ID.
# Leave them out and the site shows no ads and loads no Google script.
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=0000000000
